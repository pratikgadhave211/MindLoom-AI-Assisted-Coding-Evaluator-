FROM codercom/code-server@sha256:992796b850b8b7ec6f7393b8dd2295840a65cf5071981990ff41ef52dd566c43

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential g++ git git-lfs quilt python-is-python3 pkg-config npm \
    libx11-dev libxkbfile-dev libsecret-1-dev libkrb5-dev ca-certificates \
    && ln -sf /usr/lib/code-server/lib/node /usr/local/bin/node \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/code-server
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENTRYPOINT []
